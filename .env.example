# PsyAdapt local configuration (DO NOT COMMIT your real .env)
#
# 1) Copy this file to .env
# 2) Put your real API key into PSYADAPT_OPENAI_API_KEY
#
# AI is optional. PsyAdapt will only call the API when you enable it via:
#   - CLI: --ai
#   - Python: ai=True

# Preferred env var for this project (has priority over OPENAI_API_KEY)
PSYADAPT_OPENAI_API_KEY=sk-your_key_here

# Optional: you can also use the standard OpenAI env var instead
# OPENAI_API_KEY=sk-your_key_here
